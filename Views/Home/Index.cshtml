@{
    ViewData["Title"] = "Home Page";

    var today = DateTime.Now;

    string greeting = "Hello";
    if (today.Hour >= 0 && today.Hour < 12) 
    {
        greeting = "Good Morning!";
    } 
    else if (today.Hour >= 12 && today.Hour < 18)
    {
        greeting = "Good Afternoon!";
    } 
    else if (today.Hour >= 18 && today.Hour <= 23) 
    {
        greeting = "Good Evening!";
    }
}

<div class="container mt-5">

    <!-- Hero Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Welcome to MakersBnB!</h1>
        <h3 class="text-muted">@greeting</h3>
    </div>

    <!-- Reviews Section -->
    <div class="mx-auto" style="max-width: 600px;">
        <h3 class="mb-3 text-center">Recent Reviews</h3>

        <ul class="list-group">
            @foreach (Review review in ViewBag.Reviews)
            {
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div>
                        @review.ReviewText
                    </div>

                    <span>
                        @for (int i = 0; i < review.ReviewScore; i++)
                        {
                            <span style="color: #F5B301;">★</span>
                        }
                    </span>
                </li>
            }
        </ul>
    </div>

</div>
