@{
    ViewData["Title"] = "Home Page";

    var today = DateTime.Now;

    string greeting = "Hello";
    if (today.Hour >= 0 && today.Hour < 12) 
    {
        greeting = "Good Morning!";
    } 
    else if (today.Hour >= 12 && today.Hour < 18)
    {
        greeting = "Good Afternoon!";
    } 
    else if (today.Hour >= 18 && today.Hour <= 23) 
    {
        greeting = "Good Evening!";
    }
}

<div class="container mt-5">

    <!-- Hero Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Welcome to MakersBnB!</h1>
        <h3 class="text-muted">@greeting</h3>
    </div>

    <!-- Reviews Section -->
    <div class="mx-auto" style="max-width: 800px;">
        <h3 class="mb-3 text-center">Recent Reviews</h3>
<ul class="list-group">
@foreach (Review review in ViewBag.Reviews)
{
<li class="list-group-item">
    <div class="d-flex justify-content-between align-items-center">

        <div class="me-3">
            <strong>@review.Space?.Name</strong>
            <br />
            @review.ReviewText
            <br />
            <small class="text-muted">
                @review.Date.ToString("dd MMM yyyy")
            </small>
        </div>

        <div class="d-flex align-items-center gap-3" style="min-width: 200px; justify-content: flex-end;">
            <div>
                @for (int i = 0; i < review.ReviewScore; i++)
                {
                    <span style="color: #F5B301;">★</span>
                }
            </div>

                <a href="/Spaces" class="btn btn-outline-primary btn-sm">
                    View
                
            </a>
        </div>
    </div>
</li>
}
</ul>
<br />
    </div>
</div>
