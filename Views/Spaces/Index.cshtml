@using Microsoft.AspNetCore.Http
@model List<MakersBnB.Models.Space>

@{
    ViewData["Title"] = "Spaces";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Spaces</h1>

    @if (Context.Session.GetInt32("user_id") != null)
    {
        <a href="/Spaces/New" class="btn btn-success">Add New Space</a>
    }
</div>

<p>This is the Spaces page.</p>

<div class="row g-4">
    @foreach (var space in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">

                @if (!string.IsNullOrEmpty(space.ImageUrl))
                {
                    <img src="@space.ImageUrl" class="card-img-top" alt="@space.Name" />
                }

                <div class="card-body">
                    <h5 class="card-title">@space.Name</h5>
                    <p class="card-text">@space.Description</p>

                    <ul class="list-unstyled mb-3">
                        <li><strong>Bedrooms:</strong> @space.Bedrooms</li>
                        <li><strong>Rules:</strong> @space.Rules</li>
                        <li><strong>Price:</strong> £@space.Price</li>
                    </ul>

                    @if (space.Reviews?.Any() == true)
                    {
                        <h6 class="mt-3">Reviews</h6>
                        <ul class="list-unstyled">
                            @foreach (var review in space.Reviews)
                            {
                                <li class="mb-2">
                                    <span style="color: #F5B301; margin-right: 5px;">
                                        @for (int i = 0; i < review.ReviewScore; i++)
                                        {
                                            @:★
                                        }
                                    </span>
                                    @review.ReviewText
                                    <br />
                                    <small class="text-muted">
                                        @review.Date.ToString("dd MMM yyyy")
                                    </small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No reviews yet</p>
                    }

                    <a href="/Reviews/New?spaceId=@space.Id" class="btn btn-primary mt-3">
                        Leave a Review
                    </a>
                    <a href="#" class="btn btn-primary mt-3">Book Now</a>
                </div>
            </div>
        </div>
    }
</div>
